// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CLIENT") // "CLIENT", "ADMIN"
  company   String?
  phone     String?
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String
  role      String?
  needs     String
  budget    String
  timeline  String
  source    String   @default("CONTACT") // "CHATBOT", "CONTACT", "WHATSAPP"
  status    String   @default("NEW") // "NEW", "CONTACTED", "CONVERTED", "LOST"
  createdAt DateTime @default(now())
}

model Proposal {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  company     String
  industry    String
  employees   String
  location    String
  serviceType String
  details     String
  filePath    String?
  fileName    String?
  budget      String
  timeline    String
  status      String   @default("PENDING") // "PENDING", "REVIEWING", "SENT", "APPROVED", "REJECTED"
  generatedContent String?
  proposalTitle    String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

model Order {
  id             String   @id @default(uuid())
  clientId       String?
  serviceType    String
  companyName    String
  status         String   @default("ORDERED") // "ORDERED", "DOC_UPLOADED", "QUOTATION_GENERATED", "APPROVED", "INVOICED", "PAID", "COMPLETED"
  quotationPath  String?
  invoicePath    String?
  projectDetails String?
  createdAt      DateTime @default(now())
}

model ProjectProgress {
  id        String   @id @default(uuid())
  orderId   String
  stage     String   // "DISCOVER", "ASSESS", "DESIGN", "IMPLEMENT", "VALIDATE", "TRAIN", "SUPPORT"
  status    String   // "PENDING", "IN_PROGRESS", "COMPLETED"
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(uuid())
  clientId  String
  subject   String
  message   String
  status    String   @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  createdAt DateTime @default(now())
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  category    String   // "NEWS", "THREAT", "REGULATION", "TREND"
  content     String
  summary     String
  publishedAt DateTime @default(now())
}

model AcademyRegistration {
  id               String   @id @default(uuid())
  // A. Informasi Program
  classOption      String
  participantType  String
  
  // B. Data Pribadi
  name             String
  nikPaspor        String
  birthPlaceDate   String
  gender           String
  address          String
  domicile         String
  email            String
  phone            String
  linkedin         String
  github           String?
  
  // C. Latar Belakang Pendidikan
  educationLevel   String
  school           String
  major            String
  gpa              String?
  employmentStatus String
  
  // D. Pengalaman Kerja
  workCompany      String?
  workJobTitle     String?
  workDuration     String?
  workDescription  String?
  
  // E & F. Pengalaman IT & Cybersecurity
  itExperience     String
  cyberExperience  String
  
  // G. Sertifikasi yang Dimiliki
  certifications   String
  
  // H. Tujuan & I. Pilihan Paket
  bootcampGoals    String
  packageOption    String
  
  // J. Dokumen yang Wajib Diupload
  uploadedDocuments String
  
  // K. Metode Pembayaran
  paymentMethod    String
  
  // Q. Tanda Tangan & Corporate
  signatureName    String
  signatureDate    String
  corpName         String?
  corpPic          String?
  corpJobTitle     String?
  
  createdAt        DateTime @default(now())
}
